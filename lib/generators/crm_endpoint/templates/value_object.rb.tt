module CRM
  module Resources
<% intermediate_modules.each_with_index do |mod, i| -%>
<%= "  " * (i + 2) %>module <%= mod %>
<% end -%>
<%= "  " * (intermediates.length + 2) %><%= singular_class %> = Data.define(:id, :value)
<% intermediate_modules.length.downto(1) do |k| -%>
<%= "  " * (k + 1) %>end
<% end -%>
  end
end
