module CRM
  module Adapters
    module GetIntoTeaching
      module Resources
        module <%= list_type_module %>
          class <%= category_class %> < CRM::Resources::<%= list_type_module %>::<%= category_class %>
            def initialize(client)
              @client = client
            end

            def <%= collection %> = <%= category_module %>::<%= collection_class %>.new(@client)
          end
        end
      end
    end
  end
end
