# frozen_string_literal: true

require "rails_helper"

RSpec.describe <%= demo_collection_fqn %> do
  subject(:resource) { described_class.new }

  describe "#all" do
    it "returns an array" do
      expect(resource.all).to be_an(Array)
    end

    it "returns <%= singular_class %> instances" do
      expect(resource.all).to all(be_a(<%= crm_resource_ns %>::<%= singular_class %>))
    end

    it "returns entries with id and value readers" do
      item = resource.all.first

      expect(item).to respond_to(:id, :value)
    end
  end
end
